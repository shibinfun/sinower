<div style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
  <div style="background-color: #1e3a8a; color: white; padding: 20px; text-align: center;">
    <h1 style="margin: 0; font-size: 20px;">New Dealer Application Received</h1>
    <p style="margin: 5px 0 0; font-size: 14px; opacity: 0.9;">SINOWER USA — Dealer Network Application</p>
  </div>

  <div style="padding: 24px;">
    <h2 style="font-size: 16px; color: #1e3a8a; border-bottom: 2px solid #e2e8f0; padding-bottom: 6px; margin-top: 0;">1. Company Information</h2>
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
      <tr>
        <td style="padding: 6px 0; font-weight: bold; width: 40%;">Company Legal Name:</td>
        <td style="padding: 6px 0;"><%= @dealer_application.company_name %></td>
      </tr>
      <tr>
        <td style="padding: 6px 0; font-weight: bold;">Contact Person:</td>
        <td style="padding: 6px 0;"><%= @dealer_application.contact_person %></td>
      </tr>
      <tr>
        <td style="padding: 6px 0; font-weight: bold;">Email Address:</td>
        <td style="padding: 6px 0;"><a href="mailto:<%= @dealer_application.email %>" style="color: #2563eb;"><%= @dealer_application.email %></a></td>
      </tr>
      <tr>
        <td style="padding: 6px 0; font-weight: bold;">Phone Number:</td>
        <td style="padding: 6px 0;"><%= @dealer_application.phone %></td>
      </tr>
      <tr>
        <td style="padding: 6px 0; font-weight: bold;">Business Address:</td>
        <td style="padding: 6px 0;"><%= simple_format(@dealer_application.address) %></td>
      </tr>
      <% if @dealer_application.website.present? %>
        <tr>
          <td style="padding: 6px 0; font-weight: bold;">Company Website:</td>
          <td style="padding: 6px 0;"><a href="<%= @dealer_application.website.start_with?('http') ? @dealer_application.website : "https://#{@dealer_application.website}" %>" target="_blank" style="color: #2563eb;"><%= @dealer_application.website %></a></td>
        </tr>
      <% end %>
    </table>

    <h2 style="font-size: 16px; color: #1e3a8a; border-bottom: 2px solid #e2e8f0; padding-bottom: 6px; margin-top: 20px;">2. Business Profile</h2>
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
      <tr>
        <td style="padding: 6px 0; font-weight: bold; width: 40%;">Business Type:</td>
        <td style="padding: 6px 0;">
          <%= @dealer_application.business_type %>
          <% if @dealer_application.business_type == 'Other' && @dealer_application.business_type_other.present? %>
            (<%= @dealer_application.business_type_other %>)
          <% end %>
        </td>
      </tr>
      <% if @dealer_application.annual_purchase_volume.present? %>
        <tr>
          <td style="padding: 6px 0; font-weight: bold;">Estimated Annual Volume:</td>
          <td style="padding: 6px 0;"><%= @dealer_application.annual_purchase_volume %></td>
        </tr>
      <% end %>
      <% if @dealer_application.product_categories_list.any? %>
        <tr>
          <td style="padding: 6px 0; font-weight: bold;">Product Categories of Interest:</td>
          <td style="padding: 6px 0;">
            <%= @dealer_application.product_categories_list.join(", ") %>
            <% if @dealer_application.product_categories_list.include?('Other') && @dealer_application.product_categories_other.present? %>
              - <%= @dealer_application.product_categories_other %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </table>

    <h2 style="font-size: 16px; color: #1e3a8a; border-bottom: 2px solid #e2e8f0; padding-bottom: 6px; margin-top: 20px;">3. Additional Information</h2>
    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
      <% if @dealer_application.comments.present? %>
        <tr>
          <td style="padding: 6px 0; font-weight: bold; width: 40%; vertical-align: top;">Comments / Questions:</td>
          <td style="padding: 6px 0;"><%= simple_format(@dealer_application.comments) %></td>
        </tr>
      <% end %>
      <tr>
        <td style="padding: 6px 0; font-weight: bold; width: 40%;">Resale Certificate Attached:</td>
        <td style="padding: 6px 0;"><%= @dealer_application.resale_certificate.attached? ? "Yes (#{@dealer_application.resale_certificate.filename})" : "No" %></td>
      </tr>
    </table>

    <div style="margin-top: 30px; padding: 12px; background-color: #f8fafc; border-radius: 6px; font-size: 12px; color: #64748b; text-align: center;">
      Submitted at <%= @dealer_application.created_at.strftime("%Y-%m-%d %H:%M:%S UTC") %>
    </div>
  </div>
</div>
